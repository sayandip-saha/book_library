<div class="container admin-container">

  <!-- Admin Header -->
  <header class="admin-header">
    <div class="admin-header-main">
      <div class="admin-badge-pill">
        <span class="admin-badge-dot"></span>
        <span>Administrator System</span>
      </div>
      <h1 class="admin-title">Library Operations Dashboard</h1>
      <p class="admin-subtitle">
        Real-time metrics, shelf inventory analytics, user management, and AWS S3 media infrastructure.
      </p>
    </div>

    <div class="admin-header-actions">
      <%= link_to "+ Add New Book", new_book_path, class: "btn btn-primary btn-glow" %>
      <%= link_to "👥 Manage Users", admin_users_path, class: "btn btn-secondary" %>
      <%= link_to "📚 View Public Library", root_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <!-- Key Metrics Row -->
  <section class="admin-metrics-grid">
    <!-- Card 1: Books & Inventory -->
    <div class="admin-stat-card">
      <div class="stat-card-header">
        <span class="stat-card-label">Total Collection</span>
        <span class="stat-card-icon">📚</span>
      </div>
      <div class="stat-card-value"><%= @total_books %></div>
      <div class="stat-card-footer">
        <span class="stat-pill-sm status-available">
          <span class="status-dot"></span> <%= @available_books %> Available
        </span>
        <span class="stat-pill-sm status-borrowed">
          <span class="status-dot"></span> <%= @borrowed_books %> Borrowed
        </span>
      </div>
      <!-- Progress Bar -->
      <div class="stat-progress-bar-bg" title="<%= @availability_rate %>% Available">
        <div class="stat-progress-bar-fill" style="width: <%= @availability_rate %>%;"></div>
      </div>
      <small class="stat-progress-label"><%= @availability_rate %>% shelf availability rate</small>
    </div>

    <!-- Card 2: Taxonomy -->
    <div class="admin-stat-card">
      <div class="stat-card-header">
        <span class="stat-card-label">Catalog Taxonomy</span>
        <span class="stat-card-icon">🏷️</span>
      </div>
      <div class="stat-card-value"><%= @total_authors + @total_categories %></div>
      <div class="stat-card-footer">
        <span class="stat-submetric"><strong><%= @total_authors %></strong> Authors</span>
        <span class="stat-divider">•</span>
        <span class="stat-submetric"><strong><%= @total_categories %></strong> Categories</span>
      </div>
      <div class="stat-card-links">
        <%= link_to "Authors Directory →", authors_path, class: "stat-card-link" %>
        <%= link_to "Categories →", categories_path, class: "stat-card-link" %>
      </div>
    </div>

    <!-- Card 3: Community & Access -->
    <div class="admin-stat-card">
      <div class="stat-card-header">
        <span class="stat-card-label">User Community</span>
        <span class="stat-card-icon">👥</span>
      </div>
      <div class="stat-card-value"><%= @total_users %></div>
      <div class="stat-card-footer">
        <span class="stat-submetric"><strong><%= @admin_count %></strong> <%= 'Admin'.pluralize(@admin_count) %></span>
        <span class="stat-divider">•</span>
        <span class="stat-submetric"><strong><%= @active_sessions_count %></strong> Active <%= 'Session'.pluralize(@active_sessions_count) %></span>
      </div>
      <div class="stat-card-links">
        <%= link_to "Manage Readers & Access →", admin_users_path, class: "stat-card-link" %>
      </div>
    </div>

    <!-- Card 4: AWS S3 Storage Infrastructure -->
    <div class="admin-stat-card">
      <div class="stat-card-header">
        <span class="stat-card-label">AWS S3 Cloud Covers</span>
        <span class="stat-card-icon">☁️</span>
      </div>
      <div class="stat-card-value"><%= @s3_covers_count %></div>
      <div class="stat-card-footer">
        <span class="stat-submetric">
          <strong><%= number_to_human_size(@total_storage_bytes) %></strong> in S3
        </span>
        <span class="stat-divider">•</span>
        <span class="stat-submetric">Bucket: <code><%= ENV.fetch("AWS_BUCKET") { "book-ibrary-bucket" } %></code></span>
      </div>
      <% if @url_covers_count > 0 %>
        <div class="stat-card-action">
          <%= button_to "⚡ Sync #{@url_covers_count} Covers to S3",
                        admin_sync_covers_path,
                        method: :post,
                        class: "btn btn-primary btn-sm btn-block" %>
        </div>
      <% else %>
        <div class="stat-card-status-ok">
          <span class="badge badge-success">✓ All Covers Synced in S3</span>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Main Content Grid: Recent Books & Users -->
  <div class="admin-sections-grid">

    <!-- Recent Books Table -->
    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">📚 Shelf Inventory Snapshot</h2>
          <p class="admin-panel-desc">Recent additions and live availability status</p>
        </div>
        <%= link_to "View All Books →", books_path, class: "btn btn-secondary btn-sm" %>
      </div>

      <% if @recent_books.any? %>
        <div class="admin-table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Book</th>
                <th>Author</th>
                <th>Category</th>
                <th>Availability</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_books.each do |book| %>
                <tr>
                  <td>
                    <div class="admin-book-cell">
                      <div class="admin-book-thumb">
                        <% if book.cover_image.attached? %>
                          <%= image_tag book.cover_image, alt: book.title, class: "thumb-img" %>
                        <% elsif book.cover_url.present? %>
                          <img src="<%= book.cover_url %>" alt="<%= book.title %>" class="thumb-img" />
                        <% else %>
                          <div class="thumb-placeholder">📖</div>
                        <% end %>
                      </div>
                      <div class="admin-book-details">
                        <strong><%= link_to book.title, book_path(book), class: "admin-table-title" %></strong>
                        <small class="admin-table-meta">
                          ISBN: <%= book.isbn.presence || "N/A" %> • <%= book.publication_year %>
                          <% if book.cover_image.attached? %>
                            <span class="badge-mini badge-mini-s3">S3</span>
                          <% elsif book.cover_url.present? %>
                            <span class="badge-mini badge-mini-url">OpenLib</span>
                          <% end %>
                        </small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="admin-author-badge">
                      <%= book.author.name %>
                    </span>
                  </td>
                  <td>
                    <span class="category-chip category-chip-sm">
                      🏷️ <%= book.category.name %>
                    </span>
                  </td>
                  <td>
                    <% if book.available %>
                      <span class="status-pill status-available">
                        <span class="status-dot"></span> Available
                      </span>
                    <% else %>
                      <span class="status-pill status-borrowed">
                        <span class="status-dot"></span> Borrowed
                      </span>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <div class="admin-table-actions">
                      <%= button_to (book.available ? "Mark Borrowed" : "Mark Available"),
                                    toggle_availability_book_path(book),
                                    method: :patch,
                                    class: "btn btn-xs " + (book.available ? "btn-secondary" : "btn-primary") %>
                      <%= link_to "✏️", edit_book_path(book), class: "btn btn-xs btn-secondary", title: "Edit Book" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state">
          <p>No books in library yet.</p>
          <%= link_to "+ Create First Book", new_book_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>

    <!-- User Management Snapshot -->
    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">👥 User Accounts & Roles</h2>
          <p class="admin-panel-desc">Registered readers and administrators</p>
        </div>
        <%= link_to "View All Users →", admin_users_path, class: "btn btn-secondary btn-sm" %>
      </div>

      <div class="admin-table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Joined</th>
              <th class="text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_users.each do |user| %>
              <tr>
                <td>
                  <div class="admin-user-cell">
                    <div class="admin-user-avatar">
                      <%= user.email_address.first.upcase %>
                    </div>
                    <div>
                      <strong><%= user.email_address %></strong>
                      <% if user == Current.user %>
                        <span class="badge badge-mini badge-mini-current">You</span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if user.admin? %>
                    <span class="badge badge-success">🛡️ Administrator</span>
                  <% else %>
                    <span class="badge badge-secondary">Reader</span>
                  <% end %>
                </td>
                <td>
                  <small class="admin-table-meta">
                    <%= user.created_at.strftime("%b %d, %Y") %>
                  </small>
                </td>
                <td class="text-right">
                  <% if user != Current.user %>
                    <%= button_to (user.admin? ? "Revoke Admin" : "Make Admin"),
                                  toggle_admin_admin_user_path(user),
                                  method: :patch,
                                  class: "btn btn-xs " + (user.admin? ? "btn-secondary" : "btn-primary"),
                                  data: {
                                    turbo_confirm: "Change permissions for #{user.email_address}?"
                                  } %>
                  <% else %>
                    <small class="admin-table-meta">Active</small>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

  </div>

  <!-- System Health & Environment Bar -->
  <footer class="admin-system-footer">
    <div class="system-footer-item">
      <span class="system-footer-dot dot-green"></span>
      <span><strong>Database:</strong> MySQL 8.0 (Trilogy Adapter)</span>
    </div>
    <div class="system-footer-item">
      <span class="system-footer-dot dot-green"></span>
      <span><strong>Cloud Storage:</strong> AWS S3 (<code><%= ENV.fetch("AWS_BUCKET") { "book-ibrary-bucket" } %></code>, <%= ENV.fetch("AWS_REGION") { "ap-south-1" } %>)</span>
    </div>
    <div class="system-footer-item">
      <span class="system-footer-dot dot-green"></span>
      <span><strong>Framework:</strong> Rails 8.1 Modern Web Stack</span>
    </div>
  </footer>

</div>

