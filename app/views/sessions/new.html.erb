<div class="container">
  <div class="form-container">
    <div class="form-header">
      <div class="brand-icon" style="margin: 0 auto 16px auto;">🔐</div>
      <span class="eyebrow">BookLibrary</span>
      <h1>Welcome Back</h1>
      <p>Log in to manage your personal library collection.</p>
    </div>

    <%= form_with url: session_path do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "Email Address" %>
        <%= form.email_field :email_address,
              placeholder: "you@example.com",
              required: true,
              autofocus: true,
              autocomplete: "email" %>
      </div>

      <div class="form-group">
        <div class="form-group-header">
          <%= form.label :password, "Password" %>
          <%= link_to "Forgot password?", new_password_path, class: "forgot-link" %>
        </div>
        <%= form.password_field :password,
              placeholder: "••••••••",
              required: true,
              autocomplete: "current-password" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Log In", class: "btn btn-primary" %>
        <%= link_to "Create Account",
                    new_user_path,
                    class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
