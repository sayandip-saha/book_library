<%= form_with model: @book do |form| %>

  <% if @book.errors.any? %>
    <div class="alert alert-danger">
      <div>
        <h3>
          <%= pluralize(@book.errors.count, "error") %> prevented this book from being saved:
        </h3>
        <ul>
          <% @book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Book Title *" %>
    <%= form.text_field :title,
          placeholder: "e.g. The Name of the Wind",
          required: true,
          autofocus: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :author_id, "Author *" %>
      <%= form.collection_select(
        :author_id,
        Author.order(:name),
        :id,
        :name,
        { prompt: "Select or choose an author" },
        { required: true }
      ) %>
    </div>

    <div class="form-group">
      <%= form.label :category_id, "Category / Genre *" %>
      <%= form.collection_select(
        :category_id,
        Category.order(:name),
        :id,
        :name,
        { prompt: "Select a genre or category" },
        { required: true }
      ) %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :isbn, "ISBN Number *" %>
      <%= form.text_field :isbn,
            placeholder: "e.g. 978-0756404741",
            required: true %>
    </div>

    <div class="form-group">
      <%= form.label :publication_year, "Publication Year *" %>
      <%= form.number_field :publication_year,
            placeholder: "e.g. 2007",
            min: 1000,
            max: Time.current.year + 5,
            required: true %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :description, "Synopsis & Catalog Notes" %>
    <%= form.text_area :description,
        rows: 5,
        placeholder: "Write a summary, thematic synopsis, or personal reflections on this book..." %>
  </div>

  <div class="form-group toggle-card">
    <label class="toggle-container">
      <%= form.check_box :available, class: "toggle-checkbox" %>
      <span class="toggle-slider"></span>
      <span class="toggle-label-text">
        <strong>Book is currently Available in Library</strong>
        <small>Toggle off if this volume is on loan or borrowed</small>
      </span>
    </label>
  </div>

  <div class="form-actions">
    <%= form.submit(
      @book.new_record? ? "✨ Create Book Entry" : "💾 Save Changes",
      class: "btn btn-primary btn-glow"
    ) %>

    <%= link_to "Cancel",
                @book.persisted? ? book_path(@book) : books_path,
                class: "btn btn-secondary" %>
  </div>

<% end %>