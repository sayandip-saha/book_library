<%= form_with model: @book, id: "book_form" do |form| %>

  <% if @book.errors.any? %>
    <div class="alert alert-danger">
      <div>
        <h3>
          <%= pluralize(@book.errors.count, "error") %> prevented this book from being saved:
        </h3>
        <ul>
          <% @book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <!-- Open Library ISBN Auto-Fill Bar -->
  <div class="isbn-lookup-card">
    <div class="isbn-lookup-header">
      <div class="isbn-lookup-title">
        <span class="lookup-badge">⚡ Auto-Fill Integration</span>
        <h3>Fetch from Open Library</h3>
      </div>
      <span class="lookup-subtitle">Enter an ISBN-10 or ISBN-13 to instantly fetch the title, author, category, publication year, synopsis, and cover image.</span>
    </div>

    <div class="isbn-lookup-row">
      <div class="lookup-input-wrapper">
        <span class="lookup-icon">🔎</span>
        <input type="text"
               id="openlibrary_isbn_input"
               placeholder="Enter ISBN (e.g. 9780140328721 or 9780439708180)"
               class="lookup-field"
               value="<%= @book.isbn %>"
               autocomplete="off">
      </div>
      <div class="lookup-actions">
        <button type="button" id="btn_fetch_isbn" class="btn btn-primary lookup-btn" title="Fetch details, store author and category in database, and auto-fill form">
          <span class="btn-text">🔍 Fetch Details & Cover</span>
          <span class="btn-spinner" style="display: none;">⏳ Fetching...</span>
        </button>
      </div>
    </div>

    <div id="isbn_lookup_status" class="lookup-status" style="display: none;"></div>

    <!-- Live Book Cover Preview Card -->
    <div id="book_cover_preview_box" class="book-cover-preview-card" style="<%= (@book.cover_image.attached? || @book.cover_image_url.present?) ? '' : 'display: none;' %>">
      <div class="preview-cover-col">
        <img id="preview_cover_img"
             src="<%= @book.cover_image.attached? ? url_for(@book.cover_image) : @book.cover_image_url %>"
             alt="Book Cover Preview"
             class="preview-cover-thumb"
             onerror="this.style.display='none'; document.getElementById('preview_cover_placeholder').style.display='flex';">
        <div id="preview_cover_placeholder" class="preview-cover-fallback" style="display: none;">📖 No Image</div>
      </div>
      <div class="preview-info-col">
        <span class="preview-badge">✓ Open Library Metadata</span>
        <h4 id="preview_title"><%= @book.title.presence || "Book Title" %></h4>
        <p id="preview_author" class="preview-author-text">
          <%= @book.author&.name ? "By #{@book.author.name}" : "By Author Name" %>
        </p>
        <div class="preview-tags">
          <span id="preview_year" class="preview-tag">📅 <%= @book.publication_year.presence || "Year" %></span>
          <span id="preview_genre" class="preview-tag">🏷️ <%= @book.category&.name.presence || "Genre" %></span>
        </div>
      </div>
    </div>
  </div>

  <%= form.hidden_field :cover_image_url, id: "book_cover_image_url" %>

  <div class="form-group custom-cover-upload-group">
    <%= form.label :cover_image, "📁 Upload Custom Cover Image (from computer)" %>
    <div class="file-upload-box">
      <%= form.file_field :cover_image,
            id: "book_cover_image",
            accept: "image/png,image/jpeg,image/webp,image/gif",
            class: "custom-file-input" %>
      <small class="upload-hint">Upload a local image file (.jpg, .png, .webp). Saved securely to your cloud S3 storage.</small>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :title, "Book Title *" %>
    <%= form.text_field :title,
          id: "book_title",
          placeholder: "e.g. Fantastic Mr. Fox",
          required: true,
          autofocus: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :author_id, "Author *" %>
      <%= form.collection_select(
        :author_id,
        Author.order(:name),
        :id,
        :name,
        { prompt: "Select or choose an author" },
        { id: "book_author_id", required: true }
      ) %>
    </div>

    <div class="form-group">
      <%= form.label :category_id, "Category / Genre *" %>
      <%= form.collection_select(
        :category_id,
        Category.order(:name),
        :id,
        :name,
        { prompt: "Select a genre or category" },
        { id: "book_category_id", required: true }
      ) %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :isbn, "ISBN Number *" %>
      <%= form.text_field :isbn,
            id: "book_isbn",
            placeholder: "e.g. 9780140328721",
            required: true %>
    </div>

    <div class="form-group">
      <%= form.label :publication_year, "Publication Year *" %>
      <%= form.number_field :publication_year,
            id: "book_publication_year",
            placeholder: "e.g. 1988",
            min: 1000,
            max: Time.current.year + 5,
            required: true %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :description, "Synopsis & Catalog Notes" %>
    <%= form.text_area :description,
        id: "book_description",
        rows: 5,
        placeholder: "Write a summary, thematic synopsis, or personal reflections on this book..." %>
  </div>

  <!-- Book Availability Toggle Switch -->
  <div class="form-group">
    <label for="book_available"
           class="toggle-card <%= (@book.available.nil? || @book.available) ? 'is-available' : 'is-borrowed' %>"
           id="toggle_availability_card">
      <div class="toggle-card-main">
        <div class="toggle-status-icon-box" id="toggle_icon_box">
          <span class="toggle-status-icon" id="toggle_status_icon">
            <%= (@book.available.nil? || @book.available) ? '📚' : '📦' %>
          </span>
        </div>

        <div class="toggle-card-info">
          <div class="toggle-header-line">
            <span class="toggle-title">Library Availability Status</span>
            <span id="availability_status_badge"
                  class="badge <%= (@book.available.nil? || @book.available) ? 'badge-success' : 'badge-danger' %>">
              <%= (@book.available.nil? || @book.available) ? '● Available in Library' : '● Currently Borrowed' %>
            </span>
          </div>
          <span class="toggle-hint-text" id="toggle_hint_text">
            <%= (@book.available.nil? || @book.available) ? 'Volume is currently on the shelf and ready to be borrowed by readers.' : 'Volume is checked out or on loan to a reader.' %>
          </span>
        </div>
      </div>

      <div class="toggle-switch-wrapper">
        <%= form.check_box :available,
              class: "toggle-checkbox",
              id: "book_available",
              checked: (@book.available.nil? ? true : @book.available) %>
        <span class="toggle-switch-pill" aria-hidden="true">
          <span class="toggle-switch-knob"></span>
        </span>
      </div>
    </label>
  </div>

  <div class="form-actions">
    <%= form.submit(
      @book.new_record? ? "✨ Create Book Entry" : "💾 Save Changes",
      class: "btn btn-primary btn-glow"
    ) %>

    <%= link_to "Cancel",
                @book.persisted? ? book_path(@book) : books_path,
                class: "btn btn-secondary" %>
  </div>

<% end %>

<script>
  (function() {
    function setupBookForm() {
      // 1. Availability Toggle Interactivity
      const checkbox = document.getElementById("book_available");
      const badge = document.getElementById("availability_status_badge");
      const toggleCard = document.getElementById("toggle_availability_card");
      const statusIcon = document.getElementById("toggle_status_icon");
      const hintText = document.getElementById("toggle_hint_text");

      function updateAvailabilityUI() {
        if (!checkbox) return;
        const isAvailable = checkbox.checked;

        if (badge) {
          badge.textContent = isAvailable ? "● Available in Library" : "● Currently Borrowed";
          badge.className = `badge ${isAvailable ? "badge-success" : "badge-danger"}`;
        }
        if (statusIcon) {
          statusIcon.textContent = isAvailable ? "📚" : "📦";
        }
        if (hintText) {
          hintText.textContent = isAvailable
            ? "Volume is currently on the shelf and ready to be borrowed by readers."
            : "Volume is checked out or on loan to a reader.";
        }
        if (toggleCard) {
          toggleCard.classList.toggle("is-available", isAvailable);
          toggleCard.classList.toggle("is-borrowed", !isAvailable);
        }
      }

      if (checkbox && !checkbox.dataset.initialized) {
        checkbox.dataset.initialized = "true";
        checkbox.addEventListener("change", updateAvailabilityUI);
      }
      updateAvailabilityUI();

      // 2. Open Library ISBN Lookup Interactivity
      const isbnInput = document.getElementById("openlibrary_isbn_input");
      const btnFetch = document.getElementById("btn_fetch_isbn");
      const statusBox = document.getElementById("isbn_lookup_status");
      const previewBox = document.getElementById("book_cover_preview_box");
      const previewImg = document.getElementById("preview_cover_img");
      const previewPlaceholder = document.getElementById("preview_cover_placeholder");
      const previewTitle = document.getElementById("preview_title");
      const previewAuthor = document.getElementById("preview_author");
      const previewYear = document.getElementById("preview_year");
      const previewGenre = document.getElementById("preview_genre");

      const fieldTitle = document.getElementById("book_title");
      const fieldIsbn = document.getElementById("book_isbn");
      const fieldYear = document.getElementById("book_publication_year");
      const fieldDesc = document.getElementById("book_description");
      const fieldCover = document.getElementById("book_cover_image_url");
      const selectAuthor = document.getElementById("book_author_id");
      const selectCategory = document.getElementById("book_category_id");

      if (!btnFetch || !isbnInput) return;

      async function performLookup() {
        const rawIsbn = isbnInput.value.trim();
        if (!rawIsbn) {
          showStatus("Please enter an ISBN number to fetch.", "error");
          isbnInput.focus();
          return;
        }

        const btnText = btnFetch.querySelector(".btn-text");
        const btnSpinner = btnFetch.querySelector(".btn-spinner");

        btnFetch.disabled = true;
        if (btnText) btnText.style.display = "none";
        if (btnSpinner) btnSpinner.style.display = "inline";

        showStatus("Fetching details & storing author/category in database...", "info");

        try {
          const endpoint = `/books/lookup?isbn=${encodeURIComponent(rawIsbn)}&create_associations=true`;
          const response = await fetch(endpoint, {
            headers: { "Accept": "application/json" }
          });
          const data = await response.json();

          if (data.success) {
            // Populate form inputs
            if (data.title && fieldTitle) fieldTitle.value = data.title;
            if (data.isbn && fieldIsbn) fieldIsbn.value = data.isbn;
            if (data.publication_year && fieldYear) fieldYear.value = data.publication_year;
            if (data.description && fieldDesc) fieldDesc.value = data.description;
            if (data.cover_image_url && fieldCover) fieldCover.value = data.cover_image_url;

            // Select or add Author with real database ID
            if (data.author_id && selectAuthor) {
              let opt = Array.from(selectAuthor.options).find(o => o.value == data.author_id);
              if (!opt) {
                opt = new Option(data.author_name, data.author_id, true, true);
                selectAuthor.add(opt);
              }
              selectAuthor.value = data.author_id;
            }

            // Select or add Category with real database ID
            if (data.category_id && selectCategory) {
              let opt = Array.from(selectCategory.options).find(o => o.value == data.category_id);
              if (!opt) {
                opt = new Option(data.category_name, data.category_id, true, true);
                selectCategory.add(opt);
              }
              selectCategory.value = data.category_id;
            }

            // Update Live Preview Card
            if (previewBox) {
              previewBox.style.display = "flex";
              if (data.cover_image_url && previewImg) {
                previewImg.style.display = "block";
                previewImg.src = data.cover_image_url;
                if (previewPlaceholder) previewPlaceholder.style.display = "none";
              } else if (previewPlaceholder) {
                if (previewImg) previewImg.style.display = "none";
                previewPlaceholder.style.display = "flex";
              }
              if (previewTitle) previewTitle.textContent = data.title || "Untitled Book";
              if (previewAuthor) previewAuthor.textContent = data.author_name ? `By ${data.author_name}` : "Unknown Author";
              if (previewYear) previewYear.textContent = `📅 ${data.publication_year || "Unknown Year"}`;
              if (previewGenre) previewGenre.textContent = `🏷️ ${data.category_name || "General"}`;
            }

            showStatus(`✓ Found "${data.title}"! Stored Author ("${data.author_name}") and Category ("${data.category_name}") in database.`, "success");
          } else {
            showStatus(data.error || "Book not found on Open Library. You can still enter details manually.", "error");
          }
        } catch (err) {
          showStatus("Network error connecting to Open Library: " + err.message, "error");
        } finally {
          btnFetch.disabled = false;
          if (btnText) btnText.style.display = "inline";
          if (btnSpinner) btnSpinner.style.display = "none";
        }
      }

      function showStatus(msg, type) {
        if (!statusBox) return;
        statusBox.style.display = "block";
        statusBox.className = `lookup-status status-${type}`;
        statusBox.textContent = msg;
      }

      btnFetch.addEventListener("click", () => performLookup());

      isbnInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
          e.preventDefault();
          performLookup();
        }
      });

      // 3. Manual Image File Upload Preview
      const fileInput = document.getElementById("book_cover_image");
      if (fileInput) {
        fileInput.addEventListener("change", function(e) {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) {
              if (previewBox) previewBox.style.display = "flex";
              if (previewImg) {
                previewImg.style.display = "block";
                previewImg.src = evt.target.result;
              }
              if (previewPlaceholder) previewPlaceholder.style.display = "none";
              showStatus(`Selected local file: "${file.name}" (${(file.size / 1024).toFixed(1)} KB). Ready to upload.`, "info");
            };
            reader.readAsDataURL(file);
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupBookForm);
    } else {
      setupBookForm();
    }
    document.addEventListener("turbo:load", setupBookForm);
  })();
</script>