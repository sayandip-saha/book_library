<div class="container">

  <div class="book-show">

    <%= link_to "← Back to Books", books_path, class: "back-link" %>

    <div class="book-show-header">

      <div class="book-show-icon">
      </div>

      <div>
        <span class="book-show-label">BOOK DETAILS</span>

        <h1>
          <%= @book.title %>
        </h1>

        <p class="book-show-subtitle">
          A detailed view of your library book
        </p>
      </div>

    </div>

    <div class="book-info-grid">

      <div class="info-box">
        <span>AUTHOR</span>
        <strong><%= @book.author.name %></strong>
      </div>

      <div class="info-box">
        <span>CATEGORY</span>
        <strong><%= @book.category.name %></strong>
      </div>

      <div class="info-box">
        <span>ISBN</span>
        <strong><%= @book.isbn %></strong>
      </div>

      <div class="info-box">
        <span>PUBLICATION YEAR</span>
        <strong><%= @book.publication_year %></strong>
      </div>

      <div class="info-box">
        <span>AVAILABILITY</span>

        <% if @book.available %>
          <strong class="status available">
            ● Available
          </strong>
        <% else %>
          <strong class="status borrowed">
            ● Borrowed
          </strong>
        <% end %>

      </div>

    </div>

    <div class="description-box">

      <span>DESCRIPTION</span>

      <p>
        <%= @book.description.presence ||
            "No description has been added for this book yet." %>
      </p>

    </div>

    <div class="book-show-actions">

      <%= link_to "Edit Book",
                  edit_book_path(@book),
                  class: "btn btn-primary" %>

      <%= button_to "Delete Book",
                    @book,
                    method: :delete,
                    class: "btn btn-danger",
                    data: {
                      turbo_confirm: "Are you sure you want to delete this book?"
                    } %>

    </div>

  </div>

</div>