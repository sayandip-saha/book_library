<div class="container">

  <div class="book-show-wrapper">

    <%= link_to books_path, class: "back-nav-link" do %>
      <span class="back-arrow">←</span>
      <span>Back to Library Collection</span>
    <% end %>

    <div class="book-show-layout">

      <aside class="book-show-aside">
        <div class="book-cover-display">
          <% if @book.cover_url.present? %>
            <div class="book-cover-image-wrapper">
              <img src="<%= @book.cover_url %>"
                   alt="<%= @book.title %> Cover"
                   class="book-cover-real-img"
                   onerror="this.parentElement.style.display='none'; document.getElementById('book_cover_fallback').style.display='flex';">
            </div>
          <% end %>

          <div id="book_cover_fallback" class="book-cover-fallback-content" style="<%= @book.cover_url.present? ? 'display: none;' : '' %>">
            <div class="book-cover-spine"></div>
            <div class="book-cover-center">
              <span class="book-cover-emblem">📖</span>
              <span class="book-cover-meta-year"><%= @book.publication_year %></span>
            </div>
            <div class="book-cover-footer-isbn">
              <span class="isbn-barcode">||| | ||| || |</span>
              <span class="isbn-text"><%= @book.isbn %></span>
            </div>
          </div>

          <div class="book-cover-badge">
            <% if @book.available %>
              <span class="status-pill status-available">
                <span class="status-dot"></span> Available
              </span>
            <% else %>
              <span class="status-pill status-borrowed">
                <span class="status-dot"></span> Borrowed
              </span>
            <% end %>
          </div>
        </div>

        <div class="book-show-quick-actions">
          <!-- 1-Click Availability Toggle Button -->
          <%= button_to (@book.available ? "📦 Mark as Borrowed" : "✅ Mark as Available"),
                        toggle_availability_book_path(@book),
                        method: :patch,
                        class: (@book.available ? "btn btn-secondary btn-block" : "btn btn-primary btn-glow btn-block") %>

          <%= link_to "✏️ Edit Book Details",
                      edit_book_path(@book),
                      class: "btn btn-secondary btn-block" %>

          <%= button_to "🗑️ Delete Book",
                        @book,
                        method: :delete,
                        class: "btn btn-danger btn-block",
                        data: {
                          turbo_confirm: "Are you sure you want to permanently delete \"#{@book.title}\"?"
                        } %>
        </div>
      </aside>

      <section class="book-show-main">
        <div class="book-category-tag">
          🏷️ <%= @book.category.name %>
        </div>

        <h1 class="book-show-title"><%= @book.title %></h1>

        <div class="book-author-strip">
          <span class="author-avatar author-avatar-lg"><%= @book.author.name.first %></span>
          <div>
            <span class="author-byline-label">AUTHOR</span>
            <strong class="author-byline-name"><%= @book.author.name %></strong>
          </div>
        </div>

        <div class="book-specs-grid">
          <div class="spec-card">
            <span class="spec-label">ISBN NUMBER</span>
            <strong class="spec-value spec-code"><%= @book.isbn %></strong>
          </div>

          <div class="spec-card">
            <span class="spec-label">PUBLICATION YEAR</span>
            <strong class="spec-value"><%= @book.publication_year %></strong>
          </div>

          <div class="spec-card">
            <span class="spec-label">CIRCULATION STATUS</span>
            <% if @book.available %>
              <strong class="spec-value text-emerald">● In Library (Available)</strong>
            <% else %>
              <strong class="spec-value text-rose">● On Loan (Borrowed)</strong>
            <% end %>
          </div>

          <div class="spec-card">
            <span class="spec-label">CATEGORY / GENRE</span>
            <strong class="spec-value"><%= @book.category.name %></strong>
          </div>
        </div>

        <div class="book-synopsis-panel">
          <div class="synopsis-header">
            <span class="synopsis-icon">📜</span>
            <h3>Book Synopsis & Notes</h3>
          </div>
          <div class="synopsis-body">
            <%= simple_format(@book.description.presence || "No summary or description has been provided for this book yet. Click 'Edit Book Details' or use Open Library auto-fill to populate synopsis notes.") %>
          </div>
        </div>
      </section>

    </div>

  </div>

</div>