<article class="book-card">

  <div class="book-card-top">
    <span class="category-chip">
      🏷️ <%= book.category.name %>
    </span>

    <% if book.available %>
      <span class="status-pill status-available">
        <span class="status-dot"></span> Available
      </span>
    <% else %>
      <span class="status-pill status-borrowed">
        <span class="status-dot"></span> Borrowed
      </span>
    <% end %>
  </div>

  <div class="book-cover-mockup">
    <% if book.cover_image.attached? %>
      <%= image_tag book.cover_image,
            alt: book.title,
            class: "book-card-cover-img",
            onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';" %>
      <div class="book-card-cover-fallback" style="display: none;">
        <div class="book-spine"></div>
        <div class="book-cover-content">
          <span class="book-cover-icon">📖</span>
          <span class="book-cover-year"><%= book.publication_year %></span>
        </div>
      </div>
    <% elsif book.cover_url.present? %>
      <img src="<%= book.cover_url %>"
           alt="<%= book.title %>"
           class="book-card-cover-img"
           onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div class="book-card-cover-fallback" style="display: none;">
        <div class="book-spine"></div>
        <div class="book-cover-content">
          <span class="book-cover-icon">📖</span>
          <span class="book-cover-year"><%= book.publication_year %></span>
        </div>
      </div>
    <% else %>
      <div class="book-spine"></div>
      <div class="book-cover-content">
        <span class="book-cover-icon">📖</span>
        <span class="book-cover-year"><%= book.publication_year %></span>
      </div>
    <% end %>
  </div>

  <div class="book-card-body">
    <h3 class="book-title">
      <%= link_to book.title, book_path(book) %>
    </h3>

    <div class="book-author-line">
      <span class="author-avatar"><%= book.author.name.first %></span>
      <span class="author-name"><%= book.author.name %></span>
    </div>

    <% if book.description.present? %>
      <p class="book-excerpt">
        <%= truncate(book.description, length: 85) %>
      </p>
    <% end %>

    <div class="book-meta-footer">
      <span class="isbn-pill"># <%= book.isbn %></span>
    </div>
  </div>

  <div class="book-card-actions">
    <%= link_to "View Details →",
                book_path(book),
                class: "btn btn-primary btn-sm" %>

    <%= link_to "Edit",
                edit_book_path(book),
                class: "btn btn-secondary btn-sm" %>
  </div>

</article>