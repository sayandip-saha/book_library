<div class="container">

  <header class="page-header">
    <div class="hero-badge">
      <span class="eyebrow-dot"></span>
      <span>Taxonomy & Genres</span>
    </div>

    <h1>Categories & Genres</h1>

    <p class="hero-description">
      Organize your collection by genre and thematic category to quickly browse related literature.
    </p>

    <div class="quick-actions">
      <%= link_to "+ Add Category",
                  new_category_path,
                  class: "btn btn-primary btn-glow" %>
      <%= link_to "← Back to Library",
                  books_path,
                  class: "btn btn-secondary" %>
    </div>
  </header>

  <% if @categories.any? %>

    <div class="taxonomy-grid">

      <% @categories.each do |category| %>

        <article class="taxonomy-card">

          <div class="taxonomy-header">
            <div class="category-icon-box">
              🏷️
            </div>
            <div class="taxonomy-badge">
              <span><%= pluralize(category.books.count, "book") %></span>
            </div>
          </div>

          <h2 class="taxonomy-name">
            <%= category.name %>
          </h2>

          <div class="taxonomy-actions">
            <%= link_to "View Books",
                        books_path(category_id: category.id),
                        class: "btn btn-secondary btn-sm" %>

            <%= button_to "Delete",
                          category_path(category),
                          method: :delete,
                          class: "btn btn-danger btn-sm",
                          data: {
                            turbo_confirm: "Delete #{category.name}? (Only possible if no books are associated)"
                          } %>
          </div>

        </article>

      <% end %>

    </div>

  <% else %>

    <div class="empty-state">
      <div class="empty-state-icon">📂</div>
      <h2>No Categories Yet</h2>
      <p>
        Create genres and categories to classify your books (e.g. Science Fiction, Philosophy, History).
      </p>
      <%= link_to "+ Add First Category",
                  new_category_path,
                  class: "btn btn-primary" %>
    </div>

  <% end %>

</div>