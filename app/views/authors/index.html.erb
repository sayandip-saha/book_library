<div class="container">

  <div class="page-header">
    <span class="eyebrow">Library Management</span>

    <h1>Authors</h1>

    <p>
      Manage the authors in your personal library.
    </p>

    <%= link_to "+ Add Author",
                new_author_path,
                class: "btn btn-primary" %>
  </div>

  <% if @authors.any? %>

    <div class="books-grid">

      <% @authors.each do |author| %>

        <article class="book-card">

          <div class="book-icon">
            
          </div>

          <h2>
            <%= author.name %>
          </h2>

          <div class="book-details">

            <div class="book-detail">
              <strong>Books</strong>
              <span><%= author.books.count %></span>
            </div>

          </div>

          <div class="book-actions">

            <%= button_to "Delete",
                          author_path(author),
                          method: :delete,
                          class: "btn btn-danger",
                          data: {
                            turbo_confirm: "Delete #{author.name}?"
                          } %>

          </div>

        </article>

      <% end %>

    </div>

  <% else %>

    <div class="empty-state">

      <div class="empty-state-icon"></div>

      <h2>No authors yet</h2>

      <p>
        Add your first author to start building your library.
      </p>

      <%= link_to "Add Author",
                  new_author_path,
                  class: "btn btn-primary" %>

    </div>

  <% end %>

</div>