<div class="container">

  <header class="page-header">
    <div class="hero-badge">
      <span class="eyebrow-dot"></span>
      <span>Taxonomy & Creators</span>
    </div>

    <h1>Authors Directory</h1>

    <p class="hero-description">
      Browse all authors featured in your personal library and quickly discover all their cataloged volumes.
    </p>

    <div class="quick-actions">
      <%= link_to "+ Add Author",
                  new_author_path,
                  class: "btn btn-primary btn-glow" %>
      <%= link_to "← Back to Library",
                  books_path,
                  class: "btn btn-secondary" %>
    </div>
  </header>

  <% if @authors.any? %>

    <div class="taxonomy-grid">

      <% @authors.each do |author| %>

        <article class="taxonomy-card">

          <div class="taxonomy-header">
            <div class="author-avatar author-avatar-xl">
              <%= author.name.first %>
            </div>
            <div class="taxonomy-badge">
              <span><%= pluralize(author.books.count, "book") %></span>
            </div>
          </div>

          <h2 class="taxonomy-name">
            <%= author.name %>
          </h2>

          <div class="taxonomy-actions">
            <%= link_to "View Books",
                        books_path(author_id: author.id),
                        class: "btn btn-secondary btn-sm" %>

            <%= button_to "Delete",
                          author_path(author),
                          method: :delete,
                          class: "btn btn-danger btn-sm",
                          data: {
                            turbo_confirm: "Delete #{author.name}? (Only possible if no books are associated)"
                          } %>
          </div>

        </article>

      <% end %>

    </div>

  <% else %>

    <div class="empty-state">
      <div class="empty-state-icon">✒️</div>
      <h2>No Authors Added Yet</h2>
      <p>
        Start populating your authors list so you can organize your book collection by writer.
      </p>
      <%= link_to "+ Add First Author",
                  new_author_path,
                  class: "btn btn-primary" %>
    </div>

  <% end %>

</div>