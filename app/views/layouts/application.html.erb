<!DOCTYPE html>
<html>
  <head>
    <title>BookLibrary</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav class="navbar">

      <div class="nav-container">

        <%= link_to root_path, class: "brand" do %>
          <span class="brand-icon"></span>
          <span>BookLibrary</span>
        <% end %>

        <div class="nav-links">
  <%= link_to "Books", books_path, class: "nav-link" %>
  <%= link_to "Authors", authors_path, class: "nav-link" %>
  <%= link_to "Categories", categories_path, class: "nav-link" %>
  <%= link_to "+ Add Book", new_book_path, class: "nav-add-button" %>
</div>

      </div>

    </nav>

    <main>
      <%= yield %>
    </main>

    <footer class="footer">
      <p>© <%= Time.current.year %> BookLibrary · Built with Ruby on Rails</p>
    </footer>

  </body>
</html>